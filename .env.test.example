# Permission-matrix integration test config (npm run test:permissions).
# Copy to `.env.test.local` (gitignored) and fill in — NEVER commit real values.
# The suite SKIPS entirely if any of these is missing, so it can't run with
# hardcoded or absent credentials.

PERM_BASE_URL=http://localhost:3003
PERM_ADMIN_EMAIL=
PERM_ADMIN_PASSWORD=
PERM_STAFF_EMAIL=
PERM_STAFF_PASSWORD=
PERM_STAFF_STORE=
