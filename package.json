{
  "name": "jetline-machines",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p 3003",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "ui:audit": "bash scripts/ui-audit.sh",
    "gate": "npm run ui:audit && npm run type-check && npm run test:unit && npm run build",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --ui",
    "test:permissions": "RUN_INTEGRATION=1 vitest run tests/integration/permissions.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "vitest run --dir tests/smoke",
    "test:all": "npm run type-check && npm run test:unit && npm run test:e2e",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@imc-trading/react-pivottable": "^0.2.13",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/pg": "^8.20.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.28.1",
    "immutability-helper": "^3.1.1",
    "lucide-react": "^1.71.0",
    "mysql2": "^3.16.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.31",
    "papaparse": "^5.5.4",
    "pg": "^8.20.0",
    "prisma": "^5.22.0",
    "react": "19.2.9",
    "react-day-picker": "^10.0.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.9",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.7",
    "supertest": "^7.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  }
}
